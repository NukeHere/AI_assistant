APP_NAME=ai-assistant-core
APP_ENV=local
APP_API_TOKEN=change-me-client-token
ASSISTANT_API_URL=https://ai-assistant-4yn0.onrender.com/v1/chat/simple

# SQLite is enough for the first test build. Use Postgres later.
DATABASE_PATH=./data/assistant.sqlite3

# Local rotating backups. Later this directory can be synced to Yandex Disk.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=12
BACKUP_KEEP=10

# mock, ollama, or openai. Keep mock for the first free local test.
MODEL_PROVIDER=mock

# Ollama local API.
OLLAMA_API_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=

# OpenAI-compatible API gateway.
MODEL_API_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=llama3.1
MODEL_TIMEOUT_SECONDS=60


# Telegram interface. Keep real bot token and webhook secret only in local/Render env.
TG_BOT_API_KEY=
TG_WEBHOOK_SECRET=
TG_BOT_USERNAME=VBDsThirdSon_bot
TG_GUEST_CHAT_MODE=true
TG_SECRETARY_MODE=true
TG_BOT_TO_BOT=true

# Compact audit log for incoming messages, routing decisions and function usage.
ASSISTANT_AUDIT_LOG_PATH=./data/assistant-audit.jsonl
ASSISTANT_AUDIT_LOG_MAX_TEXT=1200
