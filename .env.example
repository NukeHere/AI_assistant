APP_NAME=ai-assistant-core
APP_ENV=local
APP_API_TOKEN=change-me-client-token
ASSISTANT_API_URL=https://ai-assistant-4yn0.onrender.com/v1/chat/simple

# Local SQLite fallback for development.
DATABASE_PATH=./data/assistant.sqlite3
# Persistent Turso Cloud database (turso:// or libsql://) for Render. Set both.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local rotating backups. Later this directory can be synced to Yandex Disk.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=12
BACKUP_KEEP=10

# mock, ollama, or openai. Keep mock for the first free local test.
MODEL_PROVIDER=mock

# Ollama local API.
OLLAMA_API_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=

# OpenAI-compatible API gateway.
MODEL_API_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=llama3.1
MODEL_TIMEOUT_SECONDS=60


# Telegram interface. Keep real bot token and webhook secret only in local/Render env.
TG_BOT_API_KEY=
TG_WEBHOOK_SECRET=
TG_BOT_USERNAME=VBDsThirdSon_bot
# Optional additional protected Telegram ID; the creator's ID is built into moderation.
TG_CREATOR_USER_ID=
TG_GUEST_CHAT_MODE=true
TG_SECRETARY_MODE=true
TG_BOT_TO_BOT=true
TG_OPEN_ACCESS=true
TG_VIDEO_DOWNLOAD_ENABLED=false
# Chance to replace a short Telegram reply with one emoji or a learned sticker (0..1).
TG_STICKER_REPLY_CHANCE=0.08
# Optional: proxy or base64-encoded Netscape cookies file for sites that challenge Render IPs.
YT_DLP_PROXY_URL=
YT_DLP_COOKIES_B64=
# Disable the local PO Token provider if its Deno process exceeds host resources.
YT_DLP_POT_ENABLED=true

# Background reminder scan while the server process is awake. Set 0 to disable.
TIMED_MEMORY_POLL_SECONDS=5
TG_DAILY_SUMMARY_POLL_SECONDS=60

# Compact audit log for incoming messages, routing decisions and function usage.
ASSISTANT_AUDIT_LOG_PATH=./data/assistant-audit.jsonl
ASSISTANT_AUDIT_LOG_MAX_TEXT=1200

# Tavily: ключ хранится только локально или в Environment на Render.
TAVILY_API_KEY=
